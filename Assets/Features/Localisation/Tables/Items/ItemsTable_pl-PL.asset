  m_TableData:
  - m_Id: 1411163451392
    m_Localized: "Drewno dryfuj\u0105ce"
    m_Metadata:
      m_Items: []
  - m_Id: 1411201200128
    m_Localized: "Gnij\u0105cy, nasi\u0105kni\u0119ty wod\u0105 kawa\u0142ek drewna"
    m_Metadata:
      m_Items: []
  - m_Id: 1411201200129
    m_Localized: Goop
    m_Metadata:
      m_Items: []
  - m_Id: 1411201200130
    m_Localized: "Mi\u0119siste resztki rybiego wroga"
    m_Metadata:
      m_Items: []
  - m_Id: 1411205394432
    m_Localized: "M\u0142otek"
    m_Metadata:
      m_Items: []
  - m_Id: 1411205394433
    m_Localized: "Stary, niezawodny spos\xF3b na budowanie i naprawianie rzeczy"
    m_Metadata:
      m_Items: []
  - m_Id: 1411205394434
    m_Localized: "Wios\u0142owa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 1411205394435
    m_Localized: "Spos\xF3b rzucania rybami"
    m_Metadata:
      m_Items: []
  - m_Id: 1411205394436
    m_Localized: Skrawek
    m_Metadata:
      m_Items: []
  - m_Id: 1411205394437
    m_Localized: "Kawa\u0142ki metalu z metalowej rzeczy"
    m_Metadata:
      m_Items: []
  - m_Id: 3159134252134400
    m_Localized: Nasiona palmy
    m_Metadata:
      m_Items: []
  - m_Id: 3159134281494528
    m_Localized: "Pocz\u0105tek czego\u015B wielkiego"
    m_Metadata:
      m_Items: []
  - m_Id: 12721394154827776
    m_Localized: "P\u0142etwa rekina"
    m_Metadata:
      m_Items: []
  - m_Id: 12721394188382208
    m_Localized: "Pot\u0119\u017Cna p\u0142etwa niebezpiecznego wroga"
    m_Metadata:
      m_Items: []
  - m_Id: 12976089012203520
    m_Localized: "P\u0142etwa tylna"
    m_Metadata:
      m_Items: []
  - m_Id: 12976089012203521
    m_Localized: "Najfajniejsza cz\u0119\u015B\u0107 rekina przyklejona do plec\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 13062890099929088
    m_Localized: "W\u0142\xF3cznia z\u0119bata"
    m_Metadata:
      m_Items: []
  - m_Id: 13062890104123392
    m_Localized: "Kiedy \u017Cycie daje ci z\u0119by, robisz w\u0142\xF3cznie"
    m_Metadata:
      m_Items: []
  - m_Id: 13071559113928704
    m_Localized: "Z\u0105b Mako"
    m_Metadata:
      m_Items: []
  - m_Id: 13071559113928705
    m_Localized: "Materia\u0142 klasy A do rozrywania tratw"
    m_Metadata:
      m_Items: []
  - m_Id: 20673045931061248
    m_Localized: Fragment muszli
    m_Metadata:
      m_Items: []
  - m_Id: 20673045960421376
    m_Localized: "Pozosta\u0142o\u015Bci rozbitej ma\u0142\u017Cy"
    m_Metadata:
      m_Items: []
